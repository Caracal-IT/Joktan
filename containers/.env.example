# Copy to .env (same folder) to change the defaults. .env is not committed.

# Host ports the broker listens on: plain MQTT, TLS, and mutual TLS.
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_MTLS_PORT=8884

# Set both to require a username and password. Leave empty for anonymous access.
MQTT_USERNAME=admin
MQTT_PASSWORD=changeme
