# Copy to .env (same folder) to change the defaults. .env is not committed.

# Host ports the broker listens on: plain MQTT, TLS, and mutual TLS.
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_MTLS_PORT=8884

# The same three for the second broker.
MQTT_PORT2=1783
MQTT_TLS_PORT2=8783
MQTT_MTLS_PORT2=8784

# Set both to require a username and password. Leave empty for anonymous access.
MQTT_USERNAME=admin
MQTT_PASSWORD=changeme

# The broker's certificate (with any intermediate CAs), its key, and the CAs client certificates
# must be signed by, relative to certs/. These are the defaults; see README.md.
MQTT_TLS_CERT=joktan/localhost/chain.pem
MQTT_TLS_KEY=joktan/localhost/key.pem
MQTT_TLS_CA=joktan/localhost/ca.pem
