<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Joktan.ViewModels"
             xmlns:views="using:Joktan.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="1400"
             x:Class="Joktan.Views.MqttView"
             x:DataType="vm:MqttViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Add client"
                        VerticalAlignment="Center"
                        Command="{Binding AddClientCommand}"
                        ToolTip.Tip="Add a client with a broker of its own. Each client has its own tab, folder and activity log." />
            </Grid>
        </Border>

        <!-- One tab per client -->
        <TabControl Classes="client-tabs" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MqttClientViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Address}">
                        <Ellipse Classes="state-dot"
                                 Classes.ok="{Binding IsConnected}"
                                 Classes.pending="{Binding IsPending}"
                                 Classes.failed="{Binding IsFailed}" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:MqttClientViewModel">
                    <views:MqttClientView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>

</UserControl>
