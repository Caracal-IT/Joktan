<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Joktan.ViewModels"
        xmlns:local="using:Joktan"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Joktan.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/joktan.ico"
        Width="1280" Height="800"
        MinWidth="720" MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Joktan">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar -->
        <Border Name="Sidebar"
                Classes="sidebar"
                Width="{StaticResource SidebarWidth}"
                IsVisible="{Binding IsSidebarOpen}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="brand" Text="joktan" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="20,0">
                    <Border Classes="avatar">
                        <TextBlock Text="{Binding UserInitials}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SidebarTextActiveBrush}" />
                        <TextBlock Text="{Binding UserRole}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SidebarTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Classes="sidebar-caption" Text="MAIN MENU" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItemViewModel">
                                <StackPanel>
                                    <Button Classes="nav-item"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding #Sidebar.((vm:MainViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <PathIcon Data="{Binding Icon}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="14,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Title}" />
                                            <PathIcon Grid.Column="2"
                                                      Classes="chevron"
                                                      Data="{x:Static local:Icons.ChevronDown}"
                                                      IsVisible="{Binding HasChildren}" />
                                        </Grid>
                                    </Button>

                                    <Border Classes="nav-children" IsVisible="{Binding IsExpanded}">
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NavItemViewModel">
                                                    <StackPanel>
                                                        <Button Classes="nav-subitem"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Command="{Binding #Sidebar.((vm:MainViewModel)DataContext).NavigateCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                                                                <PathIcon Grid.Column="1"
                                                                          Classes="chevron"
                                                                          Data="{x:Static local:Icons.ChevronDown}"
                                                                          IsVisible="{Binding HasChildren}" />
                                                            </Grid>
                                                        </Button>

                                                        <!-- Third level -->
                                                        <Border Classes="nav-children" IsVisible="{Binding IsExpanded}">
                                                            <ItemsControl ItemsSource="{Binding Children}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:NavItemViewModel">
                                                                        <Button Classes="nav-subitem"
                                                                                Classes.selected="{Binding IsSelected}"
                                                                                Command="{Binding #Sidebar.((vm:MainViewModel)DataContext).NavigateCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="{Binding Title}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">

            <!-- Top bar -->
            <Border DockPanel.Dock="Top"
                    Classes="topbar"
                    Height="{StaticResource TopBarHeight}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Classes="icon-button"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Toggle menu">
                        <PathIcon Data="{x:Static local:Icons.Menu}" />
                    </Button>

                    <TextBox Grid.Column="1"
                             Margin="24,0,40,0"
                             MaxWidth="760"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             PlaceholderText="Search for anything...">
                        <TextBox.InnerRightContent>
                            <PathIcon Data="{x:Static local:Icons.Search}"
                                      Width="16" Height="16"
                                      Margin="0,0,10,0"
                                      Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Classes="icon-button" ToolTip.Tip="Messages">
                            <PathIcon Data="{x:Static local:Icons.Message}" />
                        </Button>
                        <Panel VerticalAlignment="Center">
                            <Button Classes="icon-button" ToolTip.Tip="Notifications">
                                <PathIcon Data="{x:Static local:Icons.Bell}" />
                            </Button>
                            <Ellipse Classes="badge" />
                        </Panel>
                        <Border Classes="avatar" Margin="8,0,0,0">
                            <TextBlock Text="{Binding UserInitials}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content, resolved to a view by ViewLocator -->
            <ContentControl Content="{Binding CurrentPage}" />
        </DockPanel>
    </Grid>

</Window>
