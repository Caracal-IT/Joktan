<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Joktan.ViewModels"
        xmlns:views="using:Joktan.Views"
        x:Class="Joktan.Views.TopicExplorerWindow"
