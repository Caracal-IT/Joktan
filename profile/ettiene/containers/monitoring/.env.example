# Copy to .env (same folder) to change the defaults. .env is not committed.

# Host ports.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Where Joktan exports to, unless OTEL_EXPORTER_OTLP_ENDPOINT says otherwise.
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Grafana's administrator. These are only read the first time, when the grafana-data volume is made.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
