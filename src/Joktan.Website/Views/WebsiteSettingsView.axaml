<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Website.Resources"
             xmlns:vm="using:Joktan.Website.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Website.Views.WebsiteSettingsView"
             x:DataType="vm:WebsiteSettingsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.WebsiteSettingsView_Website}" />
                        <TextBlock Classes="card-subtitle" TextWrapping="Wrap" Text="{x:Static res:Strings.WebsiteSettingsView_WebsiteTip}" />

                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="table-cell" Text="{x:Static res:Strings.WebsiteSettingsView_Enabled}" />
                                <ToggleSwitch Name="EnabledSwitch" Grid.Column="1" Classes="compact" IsChecked="{Binding Enabled}" />
                            </Grid>
                        </Border>
                        <Border Classes="table-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Classes="table-cell" Text="{x:Static res:Strings.WebsiteSettingsView_OtherComputers}" />
                                    <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.WebsiteSettingsView_OtherComputersTip}" />
                                </StackPanel>
                                <ToggleSwitch Name="OtherComputersSwitch" Grid.Column="1" Classes="compact" IsChecked="{Binding FromOtherComputers}" />
                            </Grid>
                        </Border>

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.WebsiteSettingsView_Port}" />
                        <TextBox Name="PortBox" Width="120" HorizontalAlignment="Left" Text="{Binding PortText}" />
                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding PortError}"
                                   IsVisible="{Binding PortError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.WebsiteSettingsView_SessionHours}" />
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.WebsiteSettingsView_SessionHoursTip}" />
                        <TextBox Name="SessionHoursBox" Width="120" HorizontalAlignment="Left" Text="{Binding SessionHoursText}" />
                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding SessionHoursError}"
                                   IsVisible="{Binding SessionHoursError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Name="ServerProblemText" Classes="error" TextWrapping="Wrap" Text="{Binding ServerProblem}"
                                   IsVisible="{Binding ServerProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsListening}">
                            <Button Name="OpenButton" Classes="small" Content="{x:Static res:Strings.WebsiteSettingsView_Open}" Command="{Binding OpenCommand}" />
                            <SelectableTextBlock Classes="info-label" VerticalAlignment="Center" Text="{Binding Url}" />
                        </StackPanel>
                        <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding HasNetworkUrl}">
                            <Run Text="{x:Static res:Strings.WebsiteSettingsView_OtherComputersOpen}" />
                            <Run Text="{Binding NetworkUrl}" />
                        </TextBlock>
                        <TextBlock Classes="warning" TextWrapping="Wrap" Text="{x:Static res:Strings.WebsiteSettingsView_PlainHttp}" IsVisible="{Binding FromOtherComputers}" />
                        <TextBlock Name="SignInProblemText" Classes="warning" TextWrapping="Wrap" Text="{Binding SignInProblem}"
                                   IsVisible="{Binding SignInProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.WebsiteSettingsView_WhoSeesWhat}" />
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.WebsiteSettingsView_WhoSeesWhatTip}" />
                        <TextBlock Classes="card-title" Margin="0,8,0,0" Text="{x:Static res:Strings.WebsiteSettingsView_OtherPrograms}" />
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.WebsiteSettingsView_OtherProgramsTip}" />
                        <SelectableTextBlock FontFamily="{DynamicResource CodeFontFamily}" FontSize="{DynamicResource CodeFontSize}" TextWrapping="Wrap" Text="{x:Static res:Strings.WebsiteSettingsView_Calls}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
