  <data name="WebsiteSettingsView_OtherPrograms" xml:space="preserve">
    <value>Other programs</value>
  </data>
  <data name="WebsiteSettingsView_OtherProgramsTip" xml:space="preserve">
    <value>Programs can do what the website does, as a user, with JSON calls: sign in, then send the token as Authorization: Bearer &lt;token&gt;.</value>
  </data>
  <data name="WebsiteSettingsView_Calls" xml:space="preserve">
    <value>POST /api/login        {"username": "…", "password": "…"} → token
GET  /api/items        the user's work items
GET  /api/items/{id}   one work item, with its fields and page
POST /api/items/{id}   {"values": {"field": "value"}} answers it
GET  /api/me           who is signed in
POST /api/logout       signs out
GET  /api/pages/{id}   a page of Workflows / Pages (administrators)</value>
  </data>
