<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Data.Resources"
             xmlns:vm="using:Joktan.Data.ViewModels"
             xmlns:cvm="using:Joktan.Containers.ViewModels"
             xmlns:containers="using:Joktan.Containers"
             xmlns:pg="using:Joktan.Data.Postgres"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="Joktan.Data.Views.DataView"
             x:DataType="vm:DataViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <TabControl Name="Tabs" Padding="0" SelectedIndex="{Binding SelectedTab}">
            <TabControl.Styles>
                <Style Selector="Border.column-grip">
                    <Setter Property="Width" Value="12" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="SizeWestEast" />
                </Style>
                <Style Selector="Border.column-grip > Rectangle">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
                </Style>
                <Style Selector="Border.column-grip:pointerover > Rectangle">
                    <Setter Property="Width" Value="2" />
                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                </Style>
                <Style Selector="Border.key-badge">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Padding" Value="6,1" />
                </Style>
                <Style Selector="Border.key-badge > TextBlock">
                    <Setter Property="FontSize" Value="{DynamicResource TinyFontSize}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </Style>
                <Style Selector="TabControl#Tabs /template/ ItemsPresenter#PART_ItemsPresenter">
                    <Setter Property="Margin" Value="24,8,24,0" />
                </Style>
                <Style Selector="TabControl#Tabs > TabItem">
                    <Setter Property="FontSize" Value="{DynamicResource TabFontSize}" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="16,0" />
                </Style>
            </TabControl.Styles>

            <!-- The Mosquitto brokers, written into a compose file of their own and run through Dev Tools / Containers -->
            <TabItem Header="{x:Static res:Strings.DataView_Mqtt}">
                <ScrollViewer>
                    <StackPanel Margin="24,16,24,24" Spacing="16">
                        <!-- What the Containers page is running for the brokers -->
                        <StackPanel Spacing="4" IsVisible="{Binding Containers.IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                                <TextBlock Classes="info-label" VerticalAlignment="Center">
                                    <Run Text="{Binding Containers.Activity}" />
                                    <Run Text="…" />
                                </TextBlock>
                                <Button Classes="small" Content="{x:Static res:Strings.DataView_Cancel}" Command="{Binding Containers.CancelCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.DataView_StopTheCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Containers.Error}"
                                   IsVisible="{Binding Containers.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.DataView_MosquittoBrokers}" />
                                        <TextBlock Classes="card-subtitle" TextWrapping="Wrap" Text="{Binding Brokers.WrittenToText}" ToolTip.Tip="{Binding Brokers.ComposeFile}" />
                                        <TextBlock Classes="info-label" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static res:Strings.DataView_EachBrokerRunsAsAContainer}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="small" VerticalAlignment="Top" Content="{x:Static res:Strings.DataView_AddBroker}"
                                            Command="{Binding Brokers.AddCommand}" IsVisible="{Binding !Brokers.IsEditing}"
                                            ToolTip.Tip="{x:Static res:Strings.DataView_AddAMosquittoBroker}" />
                                </Grid>
                                <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Brokers.Error}"
                                           IsVisible="{Binding Brokers.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <!-- The list -->
                                <StackPanel Spacing="6" IsVisible="{Binding !Brokers.IsEditing}">
                                    <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding !Brokers.HasBrokers}"
                                               Text="{x:Static res:Strings.DataView_NoBrokersYet}" />
                                    <ItemsControl ItemsSource="{Binding Brokers.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="cvm:MosquittoBrokerRow">
                                                <Border Classes="table-row">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Ellipse Classes="state-dot"
                                                                             Classes.ok="{Binding IsRunning}"
                                                                             Classes.pending="{Binding IsPaused}"
                                                                             Classes.failed="{Binding IsStopped}" />
                                                                    <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Name}" />
                                                                </StackPanel>
                                                                <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" TextWrapping="Wrap" Text="{Binding StatusText}" />
                                                                <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" TextWrapping="Wrap" Text="{Binding PortsText}" />
                                                                <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" TextWrapping="Wrap" Text="{Binding Details}" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{x:Static res:Strings.DataView_TheStateOfItsMqttClient}">
                                                                    <Ellipse Classes="state-dot" Classes.ok="{Binding IsConnected}"
                                                                             Classes.pending="{Binding IsConnecting}" Classes.failed="{Binding IsConnectionFailed}" />
                                                                    <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" Text="{Binding ConnectionText}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Classes="small accent" Content="{x:Static res:Strings.DataView_Start}" Command="{Binding StartCommand}"
                                                                        IsVisible="{Binding CanStart}" ToolTip.Tip="{x:Static res:Strings.DataView_StartThisBroker}" />
                                                                <Button Classes="small" Content="{x:Static res:Strings.DataView_Stop}" Command="{Binding StopCommand}"
                                                                        IsVisible="{Binding !CanStart}" ToolTip.Tip="{x:Static res:Strings.DataView_StopThisBroker}" />
                                                                <Button Classes="small" Content="{x:Static res:Strings.DataView_Edit}" Command="{Binding EditCommand}" />
                                                                <Button Classes="small" Content="{x:Static res:Strings.DataView_RemoveBroker}" Command="{Binding RemoveCommand}"
                                                                        ToolTip.Tip="{x:Static res:Strings.DataView_RemoveTheBrokerItsContainer}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsConfirmingRemove}">
                                                            <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding RemoveText}" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Classes="small" Content="{x:Static res:Strings.DataView_Cancel}" Command="{Binding CancelRemoveCommand}" />
                                                                <Button Classes="small accent" Content="{x:Static res:Strings.DataView_RemoveBroker}" Command="{Binding ConfirmRemoveCommand}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Adding or changing one -->
                                <ContentControl Content="{Binding Brokers.Editor}" IsVisible="{Binding Brokers.IsEditing}" MaxWidth="760" HorizontalAlignment="Left">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="cvm:BrokerEditorViewModel">
                                            <StackPanel Spacing="10">
                                                <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Title}" />
                                                <StackPanel>
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_BrokerName}" />
                                                    <TextBox Classes="code" Text="{Binding NameText}" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_PlainMqttPort}" />
                                                        <TextBox Classes="code" Text="{Binding PortText}" ToolTip.Tip="{x:Static res:Strings.DataView_EmptyForNone}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_TlsPort}" />
                                                        <TextBox Classes="code" Text="{Binding TlsPortText}" ToolTip.Tip="{x:Static res:Strings.DataView_EmptyForNone}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_MutualTlsPort}" />
                                                        <TextBox Classes="code" Text="{Binding MutualTlsPortText}" ToolTip.Tip="{x:Static res:Strings.DataView_EmptyForNone}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Username}" />
                                                        <TextBox Classes="code" Text="{Binding Username}" PlaceholderText="{x:Static res:Strings.DataView_Optional}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Password}" />
                                                        <TextBox Classes="code" PasswordChar="•" Text="{Binding Password}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding PasswordHint}" />
                                                <StackPanel>
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_ServerCertificate}" />
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ServerCertificates}" SelectedItem="{Binding SelectedServerCertificate}"
                                                              ToolTip.Tip="{x:Static res:Strings.DataView_WhatTheBrokerShowsOnItsTlsPorts}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="cvm:CertificateOption">
                                                                <TextBlock Text="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap" IsVisible="{Binding HasNoServerCertificates}"
                                                               Text="{x:Static res:Strings.DataView_MakeAServerCertificateOnCertificates}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_ClientCertificatesSignedBy}" />
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ClientAuthorities}" SelectedItem="{Binding SelectedClientAuthority}"
                                                              ToolTip.Tip="{x:Static res:Strings.DataView_OnTheMutualTlsPort}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="cvm:CertificateOption">
                                                                <TextBlock Text="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button Content="{x:Static res:Strings.DataView_Cancel}" Command="{Binding CancelCommand}" />
                                                    <Button Classes="accent" Content="{x:Static res:Strings.DataView_Save}" Command="{Binding SaveCommand}"
                                                            ToolTip.Tip="{x:Static res:Strings.DataView_SaveTheBrokerAndWriteIt}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The PostgreSQL databases, written into a compose file of their own, with their data in folders on this computer -->
            <TabItem Header="{x:Static res:Strings.DataView_Database}">
                <ScrollViewer>
                    <StackPanel Margin="24,16,24,24" Spacing="16">
                        <StackPanel Spacing="4" IsVisible="{Binding Containers.IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                                <TextBlock Classes="info-label" VerticalAlignment="Center">
                                    <Run Text="{Binding Containers.Activity}" />
                                    <Run Text="…" />
                                </TextBlock>
                                <Button Classes="small" Content="{x:Static res:Strings.DataView_Cancel}" Command="{Binding Containers.CancelCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.DataView_StopTheCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Containers.Error}"
                                   IsVisible="{Binding Containers.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.DataView_PostgresDatabases}" />
                                        <TextBlock Classes="card-subtitle" TextWrapping="Wrap" Text="{Binding Databases.WrittenToText}" ToolTip.Tip="{Binding Databases.ComposeFile}" />
                                        <TextBlock Classes="info-label" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Databases.DataRootInfo}" />
                                        <TextBlock Classes="info-label" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static res:Strings.DataView_EachDatabaseRunsAsAContainer}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="small" VerticalAlignment="Top" Content="{x:Static res:Strings.DataView_AddDatabase}"
                                            Command="{Binding Databases.AddCommand}" IsVisible="{Binding !Databases.IsEditing}"
                                            ToolTip.Tip="{x:Static res:Strings.DataView_AddAPostgresDatabase}" />
                                </Grid>
                                <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Databases.Error}"
                                           IsVisible="{Binding Databases.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <!-- The list -->
                                <StackPanel Spacing="6" IsVisible="{Binding !Databases.IsEditing}">
                                    <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding !Databases.HasDatabases}"
                                               Text="{x:Static res:Strings.DataView_NoDatabasesYet}" />
                                    <ItemsControl ItemsSource="{Binding Databases.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="cvm:PostgresDatabaseRow">
                                                <Border Classes="table-row">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Ellipse Classes="state-dot"
                                                                             Classes.ok="{Binding IsRunning}"
                                                                             Classes.pending="{Binding IsPaused}"
                                                                             Classes.failed="{Binding IsStopped}" />
                                                                    <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Name}" />
                                                                </StackPanel>
                                                                <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" TextWrapping="Wrap" Text="{Binding StatusText}" />
                                                                <SelectableTextBlock Classes="code" FontSize="{DynamicResource TinyFontSize}" TextWrapping="Wrap" Text="{Binding ConnectionText}"
                                                                                     ToolTip.Tip="{x:Static res:Strings.DataView_HowToConnect}" />
                                                                <TextBlock Classes="info-label" FontSize="{DynamicResource TinyFontSize}" TextWrapping="Wrap" Text="{Binding DataFolderText}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Classes="small accent" Content="{x:Static res:Strings.DataView_Start}" Command="{Binding StartCommand}"
                                                                        IsVisible="{Binding CanStart}" ToolTip.Tip="{x:Static res:Strings.DataView_StartThisDatabase}" />
                                                                <Button Classes="small" Content="{x:Static res:Strings.DataView_Stop}" Command="{Binding StopCommand}"
                                                                        IsVisible="{Binding !CanStart}" ToolTip.Tip="{x:Static res:Strings.DataView_StopThisDatabase}" />
                                                                <Button Classes="small" Content="{x:Static res:Strings.DataView_Edit}" Command="{Binding EditCommand}" />
                                                                <Button Classes="small" Content="{x:Static res:Strings.DataView_RemoveBroker}" Command="{Binding RemoveCommand}"
                                                                        ToolTip.Tip="{x:Static res:Strings.DataView_RemoveTheDatabaseItsContainer}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsConfirmingRemove}">
                                                            <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding RemoveText}" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Classes="small" Content="{x:Static res:Strings.DataView_Cancel}" Command="{Binding CancelRemoveCommand}" />
                                                                <Button Classes="small accent" Content="{x:Static res:Strings.DataView_RemoveBroker}" Command="{Binding ConfirmRemoveCommand}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Adding or changing one -->
                                <ContentControl Content="{Binding Databases.Editor}" IsVisible="{Binding Databases.IsEditing}" MaxWidth="760" HorizontalAlignment="Left">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="cvm:DatabaseEditorViewModel">
                                            <StackPanel Spacing="10">
                                                <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Title}" />
                                                <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_BrokerName}" />
                                                        <TextBox Classes="code" Text="{Binding NameText}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Port}" />
                                                        <TextBox Classes="code" Text="{Binding PortText}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Username}" />
                                                        <TextBox Classes="code" Text="{Binding Username}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Password}" />
                                                        <TextBox Classes="code" PasswordChar="•" Text="{Binding Password}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_DatabaseName}" />
                                                        <TextBox Classes="code" Text="{Binding DatabaseText}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding PasswordHint}" />
                                                <StackPanel>
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_DataFolder}" />
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBox Classes="code" Text="{Binding DataFolderText}" ToolTip.Tip="{x:Static res:Strings.DataView_WhereTheDatabaseKeepsItsFiles}" />
                                                        <Button Grid.Column="1" Content="{x:Static res:Strings.DataView_Browse}" Command="{Binding BrowseDataFolderCommand}" />
                                                    </Grid>
                                                    <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static res:Strings.DataView_TheFolderMustBeSharedWithTheEngine}" />
                                                </StackPanel>
                                                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding SetUpHint}" />
                                                <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button Content="{x:Static res:Strings.DataView_Cancel}" Command="{Binding CancelCommand}" />
                                                    <Button Classes="accent" Content="{x:Static res:Strings.DataView_Save}" Command="{Binding SaveCommand}"
                                                            ToolTip.Tip="{x:Static res:Strings.DataView_SaveTheDatabaseAndWriteIt}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </Border>

                        <!-- The database chosen: its schemas, tables, columns and rows -->
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <TextBlock Classes="card-title" Text="{x:Static res:Strings.DataView_Browse_Title}" />
                                    <TextBlock Classes="card-subtitle" TextWrapping="Wrap" Text="{x:Static res:Strings.DataView_Browse_Subtitle}" />
                                </StackPanel>
                                <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding !Browser.HasChoices}" Text="{x:Static res:Strings.DataView_Browse_NoDatabases}" />
                                <Grid ColumnDefinitions="Auto,320,Auto,*" ColumnSpacing="8" IsVisible="{Binding Browser.HasChoices}">
                                    <TextBlock Classes="field-label" VerticalAlignment="Center" Text="{x:Static res:Strings.DataView_Browse_Database}" />
                                    <ComboBox Name="BrowseDatabase" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Browser.Choices}" SelectedItem="{Binding Browser.SelectedDatabase}"
                                              PlaceholderText="{x:Static res:Strings.DataView_Browse_ChooseADatabase}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="containers:PostgresDatabase">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="2" Classes="small" Content="{x:Static res:Strings.DataView_Browse_Refresh}" Command="{Binding Browser.RefreshCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.DataView_Browse_ReadAgain}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding Browser.IsWorking}" />
                                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Browser.Status}" />
                                    </StackPanel>
                                </Grid>
                                <SelectableTextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Browser.Error}"
                                                     IsVisible="{Binding Browser.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <Border Classes="table-row" IsVisible="{Binding Browser.IsConfirmingDrop}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding Browser.Dropping.Text}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Classes="small" Content="{x:Static res:Strings.DataView_Cancel}" Command="{Binding Browser.CancelDropCommand}" />
                                            <Button Classes="small accent" Content="{x:Static res:Strings.DataView_Browse_Drop}" Command="{Binding Browser.ConfirmDropCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="200,220,*" ColumnSpacing="16" IsVisible="{Binding Browser.IsConnected}">
                                    <!-- Schemas -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Browse_Schemas}" />
                                        <ListBox Name="Schemas" ItemsSource="{Binding Browser.Schemas}" SelectedItem="{Binding Browser.SelectedSchema}" MaxHeight="320" />
                                        <TextBox Classes="code" Text="{Binding Browser.NewSchemaName}" PlaceholderText="{x:Static res:Strings.DataView_Browse_NewSchema}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_Create}" Command="{Binding Browser.CreateSchemaCommand}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_Drop}" Command="{Binding Browser.DropSchemaCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.DataView_Browse_DropSchemaTip}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Tables of the schema chosen -->
                                    <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding Browser.HasSchema}">
                                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Browse_Tables}" />
                                        <ListBox Name="Tables" ItemsSource="{Binding Browser.Tables}" SelectedItem="{Binding Browser.SelectedTable}" MaxHeight="320" />
                                        <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding Browser.HasNoTables}" Text="{x:Static res:Strings.DataView_Browse_NoTables}" />
                                        <TextBox Classes="code" Text="{Binding Browser.NewTableName}" PlaceholderText="{x:Static res:Strings.DataView_Browse_NewTable}" />
                                        <CheckBox Content="{x:Static res:Strings.DataView_Browse_WithAnIdColumn}" IsChecked="{Binding Browser.NewTableWithId}"
                                                  ToolTip.Tip="{x:Static res:Strings.DataView_Browse_WithAnIdColumnTip}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_Create}" Command="{Binding Browser.CreateTableCommand}" />
                                            <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_Drop}" Command="{Binding Browser.DropTableCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.DataView_Browse_DropTableTip}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- The table chosen -->
                                    <StackPanel Grid.Column="2" Spacing="12">
                                        <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding !Browser.HasTable}" Text="{x:Static res:Strings.DataView_Browse_PickATable}" />
                                        <StackPanel Spacing="12" IsVisible="{Binding Browser.HasTable}">
                                            <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Browser.TableTitle}" />

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Browse_Columns}" />
                                                <Grid ColumnDefinitions="200,200,70,*,110,Auto" ColumnSpacing="12" Margin="0,4,0,6">
                                                    <TextBlock Classes="table-header" Text="{x:Static res:Strings.DataView_Browse_Column}" />
                                                    <TextBlock Grid.Column="1" Classes="table-header" Text="{x:Static res:Strings.DataView_Browse_ColumnType}" />
                                                    <TextBlock Grid.Column="2" Classes="table-header" Text="{x:Static res:Strings.DataView_Browse_Null}" />
                                                    <TextBlock Grid.Column="3" Classes="table-header" Text="{x:Static res:Strings.DataView_Browse_ColumnDefault}" />
                                                    <TextBlock Grid.Column="4" Classes="table-header" Text="{x:Static res:Strings.DataView_Browse_Key}" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Browser.Columns}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:BrowserColumn">
                                                            <Border Classes="table-row">
                                                                <Grid ColumnDefinitions="200,200,70,*,110,Auto" ColumnSpacing="12">
                                                                    <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                                                    <TextBlock Grid.Column="1" Classes="table-cell" FontFamily="{DynamicResource CodeFontFamily}" Text="{Binding Type}" ToolTip.Tip="{Binding Type}" />
                                                                    <TextBlock Grid.Column="2" Classes="table-cell" Text="{Binding NullText}" />
                                                                    <TextBlock Grid.Column="3" Classes="table-cell" FontFamily="{DynamicResource CodeFontFamily}" Text="{Binding DefaultText}" ToolTip.Tip="{Binding DefaultText}" />
                                                                    <Border Grid.Column="4" Classes="key-badge" HorizontalAlignment="Left" IsVisible="{Binding KeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                        <TextBlock Text="{Binding KeyText}" />
                                                                    </Border>
                                                                    <Button Grid.Column="5" Classes="small" Content="{x:Static res:Strings.DataView_Browse_Drop}" Command="{Binding DropCommand}"
                                                                            ToolTip.Tip="{x:Static res:Strings.DataView_Browse_DropColumnTip}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="info-label" Margin="0,4,0,0" IsVisible="{Binding Browser.HasNoColumns}" Text="{x:Static res:Strings.DataView_Browse_NoColumns}" />
                                                <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                                    <TextBox Classes="code" Text="{Binding Browser.NewColumnName}" PlaceholderText="{x:Static res:Strings.DataView_Browse_ColumnName}" />
                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True" ItemsSource="{Binding Browser.ColumnTypes}"
                                                              Text="{Binding Browser.NewColumnType}" PlaceholderText="{x:Static res:Strings.DataView_Browse_ColumnType}" />
                                                    <TextBox Grid.Column="2" Classes="code" Text="{Binding Browser.NewColumnDefault}" PlaceholderText="{x:Static res:Strings.DataView_Browse_ColumnDefault}"
                                                             ToolTip.Tip="{x:Static res:Strings.DataView_Browse_ColumnDefaultTip}" />
                                                    <CheckBox Grid.Column="3" Content="{x:Static res:Strings.DataView_Browse_NotNull}" IsChecked="{Binding Browser.NewColumnNotNull}" />
                                                    <Button Grid.Column="4" Classes="small" Content="{x:Static res:Strings.DataView_Browse_AddColumn}" Command="{Binding Browser.AddColumnCommand}"
                                                            ToolTip.Tip="{x:Static res:Strings.DataView_Browse_AddColumnTip}" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.DataView_Browse_Rows}" />
                                                    <TextBlock Classes="info-label" Text="{Binding Browser.RowsText}" />
                                                </StackPanel>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                                    <StackPanel Spacing="2">
                                                        <ItemsControl ItemsSource="{Binding Browser.HeadingCells}" Margin="0,0,0,6">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:BrowserCell">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Classes="table-header" Width="{Binding Size.Width}" TextTrimming="CharacterEllipsis" Text="{Binding Text}" ToolTip.Tip="{Binding Text}" />
                                                                        <!-- Drag to resize the column; double-click to fit it to its values -->
                                                                        <Border Classes="column-grip" ToolTip.Tip="{x:Static res:Strings.DataView_Browse_ResizeTip}"
                                                                                PointerPressed="OnGripPressed" PointerMoved="OnGripMoved" PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost">
                                                                            <Rectangle />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding Browser.Rows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:BrowserRow">
                                                                    <Border Classes="table-row">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ItemsControl ItemsSource="{Binding Shown}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:BrowserCell">
                                                                                        <TextBlock Classes="table-cell" FontFamily="{DynamicResource CodeFontFamily}" Width="{Binding Size.Width}" Margin="0,0,12,0"
                                                                                                   Text="{Binding Text}" ToolTip.Tip="{Binding Text}" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <Button Classes="small" Content="{x:Static res:Strings.DataView_Edit}" Command="{Binding EditCommand}" Margin="0,0,4,0"
                                                                                    ToolTip.Tip="{x:Static res:Strings.DataView_Browse_EditTip}" />
                                                                            <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_Delete}" Command="{Binding DeleteCommand}"
                                                                                    ToolTip.Tip="{x:Static res:Strings.DataView_Browse_DeleteTip}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                    <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_First}" Command="{Binding Browser.FirstPageCommand}" IsVisible="{Binding Browser.HasPages}" />
                                                    <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_Previous}" Command="{Binding Browser.PreviousPageCommand}" IsVisible="{Binding Browser.HasPages}" />
                                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{Binding Browser.PageNumberText}" IsVisible="{Binding Browser.HasPages}" />
                                                    <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_Next}" Command="{Binding Browser.NextPageCommand}" IsVisible="{Binding Browser.HasPages}" />
                                                    <Button Classes="small" Content="{x:Static res:Strings.DataView_Browse_Last}" Command="{Binding Browser.LastPageCommand}" IsVisible="{Binding Browser.HasPages}" />
                                                    <ComboBox Name="PageSize" ItemsSource="{Binding Browser.PageSizes}" SelectedItem="{Binding Browser.PageSize}" MinWidth="80" />
                                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="{x:Static res:Strings.DataView_Browse_PerPage}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="field-label" Text="{Binding Browser.FormTitle}" />
                                                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.DataView_Browse_InsertHint}" IsVisible="{Binding !Browser.IsEditingRow}" />
                                                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.DataView_Browse_EditHint}" IsVisible="{Binding Browser.IsEditingRow}" />
                                                <ItemsControl ItemsSource="{Binding Browser.InsertFields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:InsertField">
                                                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                                                <TextBlock Classes="code" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                                <TextBox Grid.Column="1" Classes="code" Text="{Binding Text}" PlaceholderText="{Binding Hint}" IsEnabled="{Binding !IsNull}" />
                                                                <CheckBox Grid.Column="2" Content="{x:Static res:Strings.DataView_Browse_Null}" IsChecked="{Binding IsNull}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Classes="accent" HorizontalAlignment="Left" Content="{x:Static res:Strings.DataView_Browse_Insert}" Command="{Binding Browser.InsertCommand}"
                                                        IsVisible="{Binding !Browser.IsEditingRow}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Browser.IsEditingRow}">
                                                    <Button Content="{x:Static res:Strings.DataView_Cancel}" Command="{Binding Browser.CancelEditCommand}" />
                                                    <Button Classes="accent" Content="{x:Static res:Strings.DataView_Save}" Command="{Binding Browser.SaveRowCommand}"
                                                            ToolTip.Tip="{x:Static res:Strings.DataView_Browse_SaveRowTip}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>

</UserControl>
