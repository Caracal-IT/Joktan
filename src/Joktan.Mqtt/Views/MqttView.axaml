<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Mqtt.Resources"
             xmlns:vm="using:Joktan.Mqtt.ViewModels"
             xmlns:views="using:Joktan.Mqtt.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="1400"
             x:Class="Joktan.Mqtt.Views.MqttView"
             x:DataType="vm:MqttViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{x:Static res:Strings.MqttView_AddClient}"
                        VerticalAlignment="Center"
                        Command="{Binding AddClientCommand}"
                        ToolTip.Tip="{x:Static res:Strings.MqttView_AddAClientWithABroker}" />
            </Grid>
        </Border>

        <Panel>
            <!-- Here unless the clients have been moved to their own window. It is taken away meanwhile, as each
                 client's tab tells the client which window its dialogs open over. -->
            <ContentControl x:Name="PageHost" IsVisible="{Binding ShowPage}">
                <views:MqttPanel />
            </ContentControl>

            <Border Classes="card" Margin="24" VerticalAlignment="Top" IsVisible="{Binding IsPoppedOut}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title" Text="{x:Static res:Strings.MqttView_TheMqttClientsAreOpenIn}" />
                    <TextBlock Classes="card-subtitle" Text="{x:Static res:Strings.MqttView_TheyKeepRunningWhileYouUse}" />
                    <Button Content="{x:Static res:Strings.MqttView_BackToMainWindow}" Command="{Binding DockCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>

</UserControl>
