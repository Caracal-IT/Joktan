<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Mqtt.Resources"
        xmlns:vm="using:Joktan.Mqtt.ViewModels"
        xmlns:views="using:Joktan.Mqtt.Views"
        xmlns:core="using:Joktan.Core"
        xmlns:controls="using:Joktan.Core.Controls"
        x:Class="Joktan.Mqtt.Views.MqttWindow"
        core:HelpContext.Topic="mqtt"
        x:DataType="vm:MqttViewModel"
        Icon="avares://Joktan.Core/Assets/joktan.ico"
        Width="1100" Height="760"
        MinWidth="760" MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Title="{x:Static res:Strings.MqttWindow_MqttJoktan}">

    <DockPanel>
        <!-- The window's title bar, as in the main window: drag it to move the window, double-click to maximise -->
        <Border DockPanel.Dock="Top"
                Classes="topbar"
                Height="{StaticResource TopBarHeight}"
                PointerPressed="OnTopBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{x:Static res:Strings.MqttWindow_Mqtt}" />

                <Button Grid.Column="1" Classes="small" Margin="0,0,12,0" VerticalAlignment="Center"
                        Content="{x:Static res:Strings.MqttView_AddClient}"
                        Command="{Binding AddClientCommand}"
                        ToolTip.Tip="{x:Static res:Strings.MqttView_AddAClientWithABroker}" />

                <controls:HelpButton Grid.Column="2" VerticalAlignment="Center" />

                <!-- Window controls, in place of the system title bar -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="20,0,0,0">
                    <Button Classes="window-button" ToolTip.Tip="{x:Static res:Strings.MqttWindow_Minimise}" Click="OnMinimizeClick">
                        <PathIcon Data="{x:Static core:Icons.WindowMinimize}" />
                    </Button>
                    <Button Classes="window-button" ToolTip.Tip="{x:Static res:Strings.MqttWindow_Maximise}" Name="MaximizeButton" Click="OnMaximizeClick">
                        <PathIcon Name="MaximizeIcon" Data="{x:Static core:Icons.WindowMaximize}" />
                    </Button>
                    <Button Classes="window-button close" ToolTip.Tip="{x:Static res:Strings.MqttWindow_Close}" Click="OnCloseClick">
                        <PathIcon Data="{x:Static core:Icons.WindowClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <views:MqttPanel />
    </DockPanel>

</Window>
