<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Mqtt.Resources"
             xmlns:vm="using:Joktan.Mqtt.ViewModels"
             xmlns:views="using:Joktan.Mqtt.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="1400"
             x:Class="Joktan.Mqtt.Views.RecorderView"
             x:DataType="vm:RecorderViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding ShowPage}">
                    <Button Content="{x:Static res:Strings.RecorderView_Folder}" Command="{Binding ToggleFolderCommand}"
                            ToolTip.Tip="{x:Static res:Strings.RecorderView_FolderTip}" />
                    <Button Content="{x:Static res:Strings.RecorderView_OpenRecording}" Command="{Binding OpenRecordingCommand}"
                            ToolTip.Tip="{x:Static res:Strings.RecorderView_OpenRecordingTip}" />
                    <Button Content="{x:Static res:Strings.RecorderView_OpenInOwnWindow}" Command="{Binding PopOutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel>
            <!-- Here unless the recorder has been moved to its own window. It is taken away meanwhile, as the
                 file and folder pickers open over the window the recorder is in. -->
            <ContentControl x:Name="PageHost" IsVisible="{Binding ShowPage}">
                <views:RecorderPanel />
            </ContentControl>

            <Border Classes="card" Margin="24" VerticalAlignment="Top" IsVisible="{Binding IsPoppedOut}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title" Text="{x:Static res:Strings.RecorderView_TheRecorderIsOpenIn}" />
                    <TextBlock Classes="card-subtitle" Text="{x:Static res:Strings.RecorderView_ItKeepsRunningWhileYouUse}" />
                    <Button Content="{x:Static res:Strings.RecorderView_BackToMainWindow}" Command="{Binding DockCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>

</UserControl>
