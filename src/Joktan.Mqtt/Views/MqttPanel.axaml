<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Mqtt.Resources"
             xmlns:c="using:Joktan.Mqtt.Controls"
             xmlns:vm="using:Joktan.Mqtt.ViewModels"
             xmlns:views="using:Joktan.Mqtt.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="1400"
             x:Class="Joktan.Mqtt.Views.MqttPanel"
             x:DataType="vm:MqttViewModel">

    <!-- One tab per client -->
    <Grid>
        <TabControl Classes="client-tabs" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MqttClientViewModel">
                    <Border Classes="tab-header" Background="{Binding TabFillBrush}" ToolTip.Tip="{Binding Address}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Classes="state-dot"
                                     Classes.ok="{Binding IsConnected}"
                                     Classes.pending="{Binding IsPending}"
                                     Classes.failed="{Binding IsFailed}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" c:TabText.Foreground="{Binding TabTextBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:MqttClientViewModel">
                    <views:MqttClientView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Beside the tabs, on the right -->
        <Panel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0">
            <Button Content="{x:Static res:Strings.MqttPanel_OpenInOwnWindow}"
                    Command="{Binding PopOutCommand}"
                    IsVisible="{Binding !IsPoppedOut}" />
            <Button Content="{x:Static res:Strings.MqttPanel_BackToMainWindow}"
                    Command="{Binding DockCommand}"
                    IsVisible="{Binding IsPoppedOut}" />
        </Panel>
    </Grid>

</UserControl>
