<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Mqtt.Resources"
             xmlns:vm="using:Joktan.Mqtt.ViewModels"
             xmlns:views="using:Joktan.Mqtt.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="1400"
             x:Class="Joktan.Mqtt.Views.ProxiesView"
             x:DataType="vm:ProxiesViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Static res:Strings.ProxiesView_AddProxy}" VerticalAlignment="Center" Command="{Binding AddCommand}" />
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="24" TextWrapping="Wrap" IsVisible="{Binding !HasProxies}"
                   Text="{x:Static res:Strings.ProxiesView_NoProxiesYet}" />

        <!-- One tab per proxy -->
        <TabControl Classes="client-tabs" ItemsSource="{Binding Proxies}" SelectedItem="{Binding SelectedProxy}" IsVisible="{Binding HasProxies}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProxyViewModel">
                    <Border Classes="tab-header" ToolTip.Tip="{Binding AddressText}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Classes="state-dot"
                                     Classes.ok="{Binding IsUpstreamConnected}"
                                     Classes.pending="{Binding IsUpstreamPending}"
                                     Classes.failed="{Binding IsUpstreamFailed}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ProxyViewModel">
                    <views:ProxyView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>

</UserControl>
