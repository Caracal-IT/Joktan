<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Joktan.Api.ViewModels"
             xmlns:api="using:Joktan.Api"
             xmlns:core="using:Joktan.Core"
             xmlns:controls="using:Joktan.Api.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="860"
             x:Class="Joktan.Api.Views.ApiClientView"
             x:DataType="vm:ApiClientViewModel">

    <UserControl.Resources>
        <!-- A row of a header, parameter, metadata or variable list -->
        <DataTemplate x:Key="PairRow" x:DataType="vm:ApiPairViewModel">
            <Grid ColumnDefinitions="Auto,*,2*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" ToolTip.Tip="Send it" />
                <TextBox Grid.Column="1" Classes="code" Text="{Binding Name}" PlaceholderText="Name" />
                <TextBox Grid.Column="2" Classes="code" Text="{Binding Value}" PlaceholderText="Value" />
                <Button Grid.Column="3" Classes="small" Content="Remove" Command="{Binding RemoveCommand}" />
            </Grid>
        </DataTemplate>
        <!-- A variable to save from the response -->
        <DataTemplate x:Key="CaptureRow" x:DataType="vm:ApiPairViewModel">
            <Grid ColumnDefinitions="Auto,*,2*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" ToolTip.Tip="Save it" />
                <TextBox Grid.Column="1" Classes="code" Text="{Binding Name}" PlaceholderText="Variable, such as token" />
                <TextBox Grid.Column="2" Classes="code" Text="{Binding Value}" PlaceholderText="Path in the body, such as data.token; empty for the whole body" />
                <Button Grid.Column="3" Classes="small" Content="Remove" Command="{Binding RemoveCommand}" />
            </Grid>
        </DataTemplate>
        <!-- The request as last sent, on both kinds of request -->
        <DataTemplate x:Key="LastSentView" x:DataType="vm:ApiRequestViewModel">
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding LastSentTime}"
                           IsVisible="{Binding HasLastSent}" />
                <Panel>
                    <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding !HasLastSent}"
                               Text="Nothing has been sent from this request yet." />
                    <TextBox Classes="code response" IsReadOnly="True" Text="{Binding LastSentText, Mode=OneWay}" IsVisible="{Binding HasLastSent}" />
                </Panel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="PathRow" x:DataType="vm:ApiPathViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <TextBlock Classes="code" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Path}"
                           ToolTip.Tip="{Binding Path}" />
                <Button Grid.Column="1" Classes="small" Content="Remove" Command="{Binding RemoveCommand}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HeaderRow" x:DataType="api:ApiPair">
            <Border Classes="info-row">
                <Grid ColumnDefinitions="220,*" ColumnSpacing="8">
                    <SelectableTextBlock Classes="info-value code" Margin="0" Text="{Binding Name}" />
                    <SelectableTextBlock Grid.Column="1" Classes="info-value code" Margin="0" TextWrapping="Wrap" Text="{Binding Value}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0,0,20,0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding EnvironmentChoices}" SelectedItem="{Binding SelectedEnvironment}" MinWidth="170"
                              ToolTip.Tip="Whose {{variables}} are filled in when a request is sent" />
                    <Button Content="Environments" Command="{Binding ToggleEnvironmentsCommand}"
                            ToolTip.Tip="Sets of variables, such as one per server" />
                    <Button Content="Folder" Command="{Binding ToggleWorkspaceCommand}"
                            ToolTip.Tip="Choose the folder the requests are kept in" />
                    <Button Content="New folder" Command="{Binding NewFolderCommand}" />
                    <Button Content="New gRPC" Command="{Binding NewGrpcRequestCommand}" ToolTip.Tip="Add a gRPC request" />
                    <Button Classes="accent" Content="New REST" Command="{Binding NewRestRequestCommand}" ToolTip.Tip="Add a REST request" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Where the requests are kept -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="24,16,24,0" IsVisible="{Binding IsChoosingWorkspace}">
            <StackPanel Spacing="8">
                <TextBlock Classes="card-title" Text="Requests folder" />
                <TextBlock Classes="card-subtitle" Margin="0"
                           Text="Each request is a .request.json file and each folder a folder, so the requests can be kept in a project and in version control. A folder that already holds requests is opened as it is; otherwise the requests open now are copied into it." />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Classes="code" Text="{Binding WorkspaceText}" PlaceholderText="{Binding DefaultFolder}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Browse" Command="{Binding BrowseWorkspaceCommand}" />
                        <Button Content="Default" Command="{Binding UseDefaultWorkspaceCommand}" />
                        <Button Content="Cancel" Command="{Binding ToggleWorkspaceCommand}" />
                        <Button Classes="accent" Content="Use folder" Command="{Binding ApplyWorkspaceCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding WorkspaceMessage}"
                           IsVisible="{Binding WorkspaceMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- Environments and their variables -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="24,16,24,0" IsVisible="{Binding IsEditingEnvironments}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="card-title" Text="Environments" />
                        <TextBlock Classes="card-subtitle" Margin="0,6,0,0"
                                   Text="Write {{name}} in an address, header, body or message to use a variable of the environment chosen at the top. Kept in environments.json in the requests folder." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Content="New environment" Command="{Binding NewEnvironmentCommand}" />
                        <Button Content="Close" Command="{Binding ToggleEnvironmentsCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="info-label" Text="No environments yet." IsVisible="{Binding !HasEnvironments}" />
                <Grid ColumnDefinitions="200,16,*" IsVisible="{Binding HasEnvironments}">
                    <ListBox ItemsSource="{Binding Environments}" SelectedItem="{Binding EditedEnvironment}" Classes="log" MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApiEnvironmentViewModel">
                                <TextBlock Classes="table-cell" Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2" Spacing="8" DataContext="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).EditedEnvironment}" x:DataType="vm:ApiEnvironmentViewModel"
                                IsVisible="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).EditedEnvironment, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Name}" PlaceholderText="Name" />
                            <Button Grid.Column="1" Content="Delete environment"
                                    Command="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).DeleteEnvironmentCommand}" />
                        </Grid>
                        <ScrollViewer MaxHeight="200">
                            <ItemsControl ItemsSource="{Binding Variables}" ItemTemplate="{StaticResource PairRow}" />
                        </ScrollViewer>
                        <Button Classes="small" Content="Add variable" Command="{Binding Variables.AddCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="error" Margin="24,12,24,0" TextWrapping="Wrap" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="24,12,24,0" TextWrapping="Wrap" Text="{Binding Message}"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid Margin="24" ColumnDefinitions="280,16,*">

            <!-- Folders and requests -->
            <Border Classes="card" Padding="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,8,4,8" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="card-title" Text="Requests" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="small" Content="Reload" Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Read the folder again, after files were changed outside Joktan" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Classes="info-label" Margin="12,8" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource CodeFontFamily}" FontSize="11" Text="{Binding Folder}" ToolTip.Tip="{Binding Folder}" />
                    <Panel>
                        <TextBlock Classes="info-label" Margin="12" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                                   Text="No requests yet. Add one with New REST or New gRPC, and folders to sort them with New folder." />
                        <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding TreeSelection}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem" x:DataType="vm:ApiNodeViewModel">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:ApiNodeViewModel" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Classes="node-icon" Data="{x:Static core:Icons.Folder}" IsVisible="{Binding IsFolder}" />
                                        <TextBlock Classes="method" controls:MethodColor.Method="{Binding Method}" Text="{Binding Badge}" IsVisible="{Binding IsRequest}" />
                                        <TextBlock Classes="table-cell" Text="{Binding Name}" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Panel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" VerticalAlignment="Top" IsVisible="{Binding !HasSelection}">
                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="Select a request to edit and send it, or add one with New REST or New gRPC." />
            </Border>

            <Grid Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding HasSelection}">

                <!-- Name, folder and delete, for a request or a folder -->
                <Border Classes="card" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="8">
                            <TextBox x:Name="NameBox" Text="{Binding EditName}" PlaceholderText="Name"
                                     ToolTip.Tip="Renames the file or folder when you press Enter or leave the box" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding EditFolder}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="The folder it is in; choose another to move it" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" IsVisible="{Binding !IsFolderSelected}" />
                                <Button Content="Delete" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="info-label" Text="{Binding FolderSummary}" IsVisible="{Binding IsFolderSelected}" />
                        <Border Classes="group-row" Padding="12" IsVisible="{Binding IsConfirmingDelete}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding DeleteText}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                                    <Button Classes="accent" Content="Delete" Command="{Binding ConfirmDeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- The request and its response -->
                <Grid Grid.Row="1" RowDefinitions="*,8,*" DataContext="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).Request}" x:DataType="vm:ApiRequestViewModel"
                      IsVisible="{Binding $parent[UserControl].((vm:ApiClientViewModel)DataContext).HasRequest}">

                    <Border Classes="card" Padding="16">
                        <DockPanel>
                            <!-- REST: method, address, send -->
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsRest}">
                                <ComboBox ItemsSource="{Binding MethodChoices}" SelectedItem="{Binding Method}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="method choice" controls:MethodColor.Method="{Binding}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Column="1" Classes="code" Text="{Binding Url}" PlaceholderText="https://api.example.com/items or {{baseUrl}}/items" />
                                <Panel Grid.Column="2">
                                    <Button Classes="accent" Content="Send" Command="{Binding SendCommand}" IsVisible="{Binding IsNotSending}" MinWidth="80" />
                                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsSending}" MinWidth="80" />
                                </Panel>
                                <Button Grid.Column="3" Content="Resend" Command="{Binding ResendCommand}" IsVisible="{Binding CanResend}"
                                        ToolTip.Tip="Send the last request again as it was sent, even if it has been edited since. Variables are filled in from the environment in use." />
                            </Grid>

                            <!-- gRPC: address, send, service and method -->
                            <StackPanel DockPanel.Dock="Top" Spacing="8" IsVisible="{Binding IsGrpc}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Classes="code" Text="{Binding Address}" PlaceholderText="https://localhost:5001, or http://localhost:5000 for plain HTTP/2" />
                                    <Panel Grid.Column="1">
                                        <Button Classes="accent" Content="Send" Command="{Binding SendCommand}" IsVisible="{Binding IsNotSending}" MinWidth="80" />
                                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsSending}" MinWidth="80" />
                                    </Panel>
                                    <Button Grid.Column="2" Content="Resend" Command="{Binding ResendCommand}" IsVisible="{Binding CanResend}"
                                            ToolTip.Tip="Send the last message again as it was sent, even if it has been edited since. Variables are filled in from the environment in use." />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding ServiceChoice}" HorizontalAlignment="Stretch"
                                              PlaceholderText="Service" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Methods}" SelectedItem="{Binding RpcChoice}" HorizontalAlignment="Stretch"
                                              PlaceholderText="Method" />
                                    <Button Grid.Column="2" Content="Load services" Command="{Binding LoadServicesCommand}"
                                            ToolTip.Tip="Ask the server, or read the .proto files, as set on the Schema tab" />
                                </Grid>
                                <TextBlock Classes="info-label" TextWrapping="Wrap">
                                    <Run Text="{Binding MethodText}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SchemaStatus}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Top" Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <!-- REST tabs -->
                            <TabControl Margin="0,8,0,0" IsVisible="{Binding IsRest}">
                                <TabItem Header="Params">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Query}" ItemTemplate="{StaticResource PairRow}" />
                                            <Button Classes="small" Content="Add parameter" Command="{Binding Query.AddCommand}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Headers">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Headers}" ItemTemplate="{StaticResource PairRow}" />
                                            <Button Classes="small" Content="Add header" Command="{Binding Headers.AddCommand}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Body">
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                            <ComboBox ItemsSource="{Binding BodyKinds}" SelectedItem="{Binding BodyKind}" Width="140" />
                                            <Button Classes="small" Content="Format JSON" Command="{Binding FormatBodyCommand}" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsBodyText}" />
                                        </StackPanel>
                                        <Panel>
                                            <TextBox Classes="code note-editor" Text="{Binding Body}" IsVisible="{Binding IsBodyText}" />
                                            <ScrollViewer IsVisible="{Binding IsBodyForm}">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Form}" ItemTemplate="{StaticResource PairRow}" />
                                                    <Button Classes="small" Content="Add field" Command="{Binding Form.AddCommand}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Panel>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Auth">
                                    <StackPanel Margin="0,8,0,0" Spacing="12">
                                        <ComboBox ItemsSource="{Binding AuthKinds}" SelectedItem="{Binding AuthKind}" Width="140" />
                                        <StackPanel IsVisible="{Binding IsBearer}">
                                            <TextBlock Classes="field-label" Text="Token" />
                                            <TextBox Classes="code" Text="{Binding Token}" PlaceholderText="{}{{token}}" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsBasic}">
                                            <StackPanel>
                                                <TextBlock Classes="field-label" Text="Username" />
                                                <TextBox Text="{Binding Username}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="field-label" Text="Password" />
                                                <TextBox PasswordChar="•" Text="{Binding Password}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Classes="info-label" TextWrapping="Wrap"
                                                   Text="Saved in the request's file as written. Put secrets in an environment variable, such as {{token}}, to keep them out of shared requests." />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Save to variables">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Captures}" ItemTemplate="{StaticResource CaptureRow}" />
                                            <Button Classes="small" Content="Add variable" Command="{Binding Captures.AddCommand}" />
                                            <TextBlock Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Text="After a successful response, each value is saved in the environment chosen at the top, for {{name}} in other requests. Saved values are kept in environments.json." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Last sent">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LastSentView}" />
                                </TabItem>
                                <TabItem Header="Settings">
                                    <StackPanel Margin="0,8,0,0" Spacing="12">
                                        <CheckBox Content="Accept any TLS certificate (for local servers with self-signed ones)" IsChecked="{Binding AcceptAnyCertificate}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="info-label" Text="Give up after" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="3600" Increment="5" FormatString="0" Width="120" />
                                            <TextBlock Classes="info-label" Text="seconds" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <!-- gRPC tabs -->
                            <TabControl Margin="0,8,0,0" IsVisible="{Binding IsGrpc}">
                                <TabItem Header="Message">
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                            <Button Classes="small" Content="Example message" Command="{Binding TemplateCommand}"
                                                    ToolTip.Tip="Fill in every field of the method's request message" />
                                            <Button Classes="small" Content="Format JSON" Command="{Binding FormatMessageCommand}" />
                                        </StackPanel>
                                        <TextBox Classes="code note-editor" Text="{Binding Message}" />
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Metadata">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Metadata}" ItemTemplate="{StaticResource PairRow}" />
                                            <Button Classes="small" Content="Add metadata" Command="{Binding Metadata.AddCommand}" />
                                            <TextBlock Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Text="Such as authorization: Bearer {{token}}. Names ending in -bin take base64 values." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Schema">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0" Spacing="8">
                                            <RadioButton GroupName="schema" IsChecked="{Binding UsesReflection}"
                                                         Content="Ask the server (gRPC server reflection)" />
                                            <RadioButton GroupName="schema" IsChecked="{Binding UsesProtoFiles}" Content="Read .proto files" />
                                            <StackPanel Margin="28,4,0,0" Spacing="6" IsVisible="{Binding UsesProtoFiles}">
                                                <ItemsControl ItemsSource="{Binding ProtoFiles}" ItemTemplate="{StaticResource PathRow}" />
                                                <Button Classes="small" Content="Add .proto files" Command="{Binding AddProtoFilesCommand}" />
                                                <TextBlock Classes="field-label" Margin="0,8,0,4" Text="Folders to look for imports in, besides each file's own" />
                                                <ItemsControl ItemsSource="{Binding ImportPaths}" ItemTemplate="{StaticResource PathRow}" />
                                                <Button Classes="small" Content="Add import folder" Command="{Binding AddImportPathCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Save to variables">
                                    <ScrollViewer>
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Captures}" ItemTemplate="{StaticResource CaptureRow}" />
                                            <Button Classes="small" Content="Add variable" Command="{Binding Captures.AddCommand}" />
                                            <TextBlock Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Text="After a successful response, each value is saved in the environment chosen at the top, for {{name}} in other requests. A stream's answer is an array of messages, so start the path with [0]. Saved values are kept in environments.json." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Last sent">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LastSentView}" />
                                </TabItem>
                                <TabItem Header="Settings">
                                    <StackPanel Margin="0,8,0,0" Spacing="12">
                                        <CheckBox Content="Accept any TLS certificate (for local servers with self-signed ones)" IsChecked="{Binding AcceptAnyCertificate}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="info-label" Text="Deadline" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="3600" Increment="5" FormatString="0" Width="120" />
                                            <TextBlock Classes="info-label" Text="seconds" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows" />

                    <!-- The response -->
                    <Border Grid.Row="2" Classes="card" Padding="16">
                        <Panel>
                            <TextBlock Classes="info-label" Text="Send the request to see the response here." IsVisible="{Binding !HasResponse}" />
                            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsSending}" />
                            <DockPanel IsVisible="{Binding HasResponse}">
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border Classes="status" Classes.ok="{Binding Response.IsSuccess, FallbackValue=False}"
                                            Classes.failed="{Binding Response.IsFailure, FallbackValue=False}">
                                        <SelectableTextBlock Text="{Binding Response.Status, FallbackValue=''}" TextWrapping="Wrap" MaxWidth="600" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="info-label" VerticalAlignment="Center">
                                        <Run Text="{Binding Response.Elapsed, FallbackValue=''}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Response.Size, FallbackValue=''}" />
                                    </TextBlock>
                                    <Button Grid.Column="2" Classes="small" Content="Copy body" Command="{Binding CopyBodyCommand}" />
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" Classes="info-label" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SavedVariables}"
                                           IsVisible="{Binding SavedVariables, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TabControl Margin="0,8,0,0">
                                    <TabItem Header="Body">
                                        <TextBox Classes="code response" Margin="0,8,0,0" IsReadOnly="True" Text="{Binding Response.Body, FallbackValue=''}" />
                                    </TabItem>
                                    <TabItem Header="Headers">
                                        <ScrollViewer>
                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Response.Headers, FallbackValue={x:Null}}" ItemTemplate="{StaticResource HeaderRow}" />
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Trailers" IsVisible="{Binding Response.HasTrailers, FallbackValue=False}">
                                        <ScrollViewer>
                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Response.Trailers, FallbackValue={x:Null}}" ItemTemplate="{StaticResource HeaderRow}" />
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Panel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>

</UserControl>
