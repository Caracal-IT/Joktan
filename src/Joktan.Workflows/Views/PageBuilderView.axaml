<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Workflows.Resources"
             xmlns:vm="using:Joktan.Workflows.ViewModels"
             xmlns:model="using:Joktan.Workflows.Model"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="Joktan.Workflows.Views.PageBuilderView"
             x:DataType="vm:PageBuilderViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.multi">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.palette-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.page-heading">
            <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- The page as the website shows it, with the item being changed picked out -->
        <Style Selector="ListBox#ItemsList ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                    <TextBlock Classes="page-title" Text="{Binding Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" ItemSpacing="8" LineSpacing="8">
                    <Button Name="DuplicateButton" Content="{x:Static res:Strings.Designer_Duplicate}" Command="{Binding DuplicateCommand}" IsEnabled="{Binding HasPage}" />
                    <Button Name="DeleteButton" Content="{x:Static res:Strings.Designer_Delete}" Command="{Binding AskDeleteCommand}" IsEnabled="{Binding HasPage}" />
                    <Button Name="NewPageButton" Content="{x:Static res:Strings.Pages_New}" Command="{Binding NewPageCommand}" />
                    <Button Name="PreviewButton" Classes="accent" Content="{x:Static res:Strings.Pages_Preview}" Command="{Binding PreviewCommand}" IsEnabled="{Binding HasPage}"
                            ToolTip.Tip="{Binding PreviewUrlText}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Classes="card" Margin="24,16,24,0" IsVisible="{Binding IsConfirmingDelete}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.Designer_Cancel}" Command="{Binding CancelDeleteCommand}" />
                    <Button Name="ConfirmDeleteButton" Classes="accent" Content="{x:Static res:Strings.Designer_DeleteIt}" Command="{Binding ConfirmDeleteCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_DeleteQuestion}" />
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Classes="error" Margin="24,12,24,0" TextWrapping="Wrap" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid ColumnDefinitions="240,12,*,12,380" Margin="24,16,24,24">
            <!-- The pages, and what can be put on one -->
            <ScrollViewer>
                <StackPanel Spacing="8">
                    <TextBlock Classes="card-title" Text="{x:Static res:Strings.Pages_Pages}" />
                    <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_NoPages}" IsVisible="{Binding HasNoPages}" />
                    <ListBox Name="PagesList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" MaxHeight="320">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="model:WorkflowPage">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Spacing="4" IsVisible="{Binding HasPage}" Margin="0,8,0,0">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.Pages_Add}" />
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_AddTip}" />
                        <TextBlock Classes="field-label" Margin="0,6,0,2" Text="{x:Static res:Strings.Pages_Shown}" />
                        <ItemsControl Name="ShownPalette" ItemsSource="{Binding ShownTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PageItemTypeChoice">
                                    <Button Classes="palette-item" Content="{Binding Text}"
                                            Command="{Binding $parent[ItemsControl].((vm:PageBuilderViewModel)DataContext).AddItemCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="field-label" Margin="0,6,0,2" Text="{x:Static res:Strings.Pages_FilledIn}" />
                        <ItemsControl Name="InputPalette" ItemsSource="{Binding InputTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PageItemTypeChoice">
                                    <Button Classes="palette-item" Content="{Binding Text}"
                                            Command="{Binding $parent[ItemsControl].((vm:PageBuilderViewModel)DataContext).AddItemCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- The page, laid out as the website shows it -->
            <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasPage}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Classes="page-heading" Text="{Binding PageTitle}"
                                   IsVisible="{Binding PageTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_TitleFromQuestion}"
                                   IsVisible="{Binding PageTitle, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        <TextBlock Classes="card-subtitle" TextWrapping="Wrap" Text="{Binding PageDescription}"
                                   IsVisible="{Binding PageDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Name="MoveUpButton" Classes="small" Content="{x:Static res:Strings.Pages_MoveUp}" Command="{Binding MoveUpCommand}" />
                        <Button Name="MoveDownButton" Classes="small" Content="{x:Static res:Strings.Pages_MoveDown}" Command="{Binding MoveDownCommand}" />
                        <Button Name="RemoveItemButton" Classes="small" Content="{x:Static res:Strings.Designer_Remove}" Command="{Binding RemoveItemCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Name="ProblemText" Classes="warning" Margin="0,8,0,0" Text="{Binding Problem}"
                               IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ListBox Name="ItemsList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageItemViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="page-heading" Text="{Binding Summary}" IsVisible="{Binding IsHeading}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Summary}" IsVisible="{Binding IsText}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsValue}">
                                        <TextBlock Classes="field-label" Text="{Binding Caption}" />
                                        <TextBlock Grid.Column="1" Classes="code" TextWrapping="Wrap" Text="{Binding Summary}" />
                                    </Grid>
                                    <Separator IsVisible="{Binding IsDivider}" />
                                    <StackPanel Spacing="4" IsVisible="{Binding IsInput}">
                                        <TextBlock Classes="field-label" Text="{Binding Caption}" IsVisible="{Binding !IsCheckBox}" />
                                        <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False" Text="{Binding Sample}" PlaceholderText="{Binding Placeholder}"
                                                 IsVisible="{Binding IsTextBox}" />
                                        <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False" Classes="multi" Text="{Binding Sample}"
                                                 PlaceholderText="{Binding Placeholder}" IsVisible="{Binding IsTextArea}" />
                                        <CheckBox IsHitTestVisible="False" Focusable="False" IsChecked="{Binding IsTicked, Mode=OneWay}" Content="{Binding Caption}"
                                                  IsVisible="{Binding IsCheckBox}" />
                                        <ComboBox IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Stretch" PlaceholderText="{Binding Sample}"
                                                  IsVisible="{Binding IsDropDown}" />
                                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Help}" IsVisible="{Binding HasHelp}" />
                                    </StackPanel>
                                    <TextBlock Classes="info-label" FontSize="{DynamicResource SmallFontSize}" Text="{Binding TypeText}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <TextBlock Grid.Column="2" Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_ChooseOrMake}" IsVisible="{Binding !HasPage}" />

            <!-- The page's settings, and those of the item selected -->
            <ScrollViewer Grid.Column="4" IsVisible="{Binding HasPage}">
                <StackPanel Spacing="12">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.Pages_Page}" />
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_Name}" />
                            <TextBox Name="PageNameBox" Text="{Binding PageName}" />
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_PageTitle}" />
                            <TextBox Name="PageTitleBox" Text="{Binding PageTitle}" PlaceholderText="{x:Static res:Strings.Pages_PageTitleHint}" />
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_Description}" />
                            <TextBox Classes="multi" Text="{Binding PageDescription}" />
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_SubmitText}" />
                            <TextBox Text="{Binding SubmitText}" PlaceholderText="{x:Static res:Strings.Pages_SubmitTextHint}" />
                            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_PathsTip}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding HasItem}">
                        <StackPanel Spacing="8" DataContext="{Binding SelectedItem}" x:DataType="vm:PageItemViewModel">
                            <TextBlock Classes="card-title" Text="{Binding TypeText}" />
                            <StackPanel Spacing="8" IsVisible="{Binding IsInput}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_FieldName}" />
                                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_FieldNameTip}" />
                                <TextBox Name="FieldNameBox" Classes="code" Text="{Binding Name}" />
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding HasLabel}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_Label}" />
                                <TextBox Name="LabelBox" Text="{Binding Label}" />
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding HasText}">
                                <TextBlock Classes="field-label" Text="{Binding TextLabel}" />
                                <TextBox Name="ItemTextBox" Classes="multi" Text="{Binding Text}" />
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding IsDropDown}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_Options}" />
                                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_OptionsTip}" />
                                <TextBox Name="OptionsBox" Classes="multi code" Text="{Binding OptionsText}" />
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding IsInput}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_Default}" />
                                <TextBox Classes="code" Text="{Binding Default}" PlaceholderText="{x:Static res:Strings.Pages_DefaultHint}" />
                                <StackPanel Spacing="8" IsVisible="{Binding HasPlaceholder}">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_Placeholder}" />
                                    <TextBox Text="{Binding Placeholder}" />
                                </StackPanel>
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Pages_Help}" />
                                <TextBox Text="{Binding Help}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Classes="table-cell" Text="{x:Static res:Strings.Pages_Required}" />
                                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.Pages_RequiredTip}" />
                                    </StackPanel>
                                    <ToggleSwitch Name="RequiredSwitch" Grid.Column="1" Classes="compact" IsChecked="{Binding Required}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
