<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Workflows.Resources"
        xmlns:vm="using:Joktan.Workflows.ViewModels"
        xmlns:model="using:Joktan.Workflows.Model"
        xmlns:controls="using:Joktan.Workflows.Controls"
        xmlns:views="using:Joktan.Workflows.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Joktan.Workflows.Views.CodeEditorWindow"
        x:DataType="vm:StepViewModel"
        Width="1200" Height="800" MinWidth="700" MinHeight="400"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <!-- The code of a script step, in a window of its own; it edits the same step as the designer's panel -->
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox Name="InsertVariableBox" ItemsSource="{Binding VariableChoices}" MinWidth="180"
                          PlaceholderText="{x:Static res:Strings.Step_InsertVariable}" IsVisible="{Binding HasVariableChoices}" />
                <ComboBox Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" MinWidth="140">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:ScriptLanguage">
                            <TextBlock Text="{Binding Converter={x:Static model:StepTypes.LanguageConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Name="CheckButton" Content="{x:Static res:Strings.Designer_CheckCode}" Command="{Binding CheckCodeCommand}" IsVisible="{Binding CanCheckCode}" />
                <Button Name="CloseButton" Classes="accent" Content="{x:Static res:Strings.Step_Done}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Name}" />
                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding CodeTip}" />
            </StackPanel>
        </DockPanel>

        <SelectableTextBlock DockPanel.Dock="Bottom" Classes="info-value code" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="120"
                             Text="{Binding CodeCheck}" IsVisible="{Binding CodeCheck, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Grid ColumnDefinitions="*,320" ColumnSpacing="16">
            <controls:CodeEditor Name="Editor" Code="{Binding Code}" Language="{Binding Language}" />
            <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
                <views:ScriptLibrariesView />
            </Border>
        </Grid>
    </DockPanel>
</Window>
