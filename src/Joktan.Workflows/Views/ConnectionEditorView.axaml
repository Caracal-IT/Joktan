<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Workflows.Resources"
             xmlns:vm="using:Joktan.Workflows.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420"
             x:Class="Joktan.Workflows.Views.ConnectionEditorView"
             x:DataType="vm:ConnectionEditorViewModel">
    <!-- A database connection being made or changed; its password goes to the credential store -->
    <StackPanel Spacing="8">
        <TextBlock Classes="card-title" Text="{Binding Title}" />
        <TextBlock Classes="field-label" Text="{x:Static res:Strings.Connection_Name}" />
        <TextBox Name="ConnectionNameBox" Text="{Binding Name}" PlaceholderText="{x:Static res:Strings.Connection_NameExample}" />
        <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Connection_Host}" />
                <TextBox Classes="code" Text="{Binding Host}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Connection_Port}" />
                <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" ShowButtonSpinner="False" />
            </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Connection_Username}" />
                <TextBox Classes="code" Text="{Binding Username}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="field-label" Text="{x:Static res:Strings.Connection_Database}" />
                <TextBox Classes="code" Text="{Binding Database}" />
            </StackPanel>
        </Grid>
        <TextBlock Classes="field-label" Text="{x:Static res:Strings.Connection_PasswordLabel}" />
        <TextBox PasswordChar="●" Text="{Binding Password}" PlaceholderText="{Binding PasswordHint}" />
        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="small" Content="{x:Static res:Strings.Connection_Test}" Command="{Binding TestCommand}" IsEnabled="{Binding !IsTesting}" />
            <Button Name="SaveConnectionButton" Classes="small accent" Content="{x:Static res:Strings.Connection_Save}" Command="{Binding SaveCommand}" />
            <Button Classes="small" Content="{x:Static res:Strings.Connection_Cancel}" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
