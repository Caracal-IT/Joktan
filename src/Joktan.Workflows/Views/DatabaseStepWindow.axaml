<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Joktan.Workflows.Resources"
        xmlns:vm="using:Joktan.Workflows.ViewModels"
        xmlns:model="using:Joktan.Workflows.Model"
        xmlns:engine="using:Joktan.Workflows.Engine"
        xmlns:views="using:Joktan.Workflows.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="780"
        x:Class="Joktan.Workflows.Views.DatabaseStepWindow"
        x:DataType="vm:DatabaseStepViewModel"
        Width="1180" Height="780" MinWidth="820" MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.key-badge">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style Selector="Border.key-badge > TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TinyFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <!-- A database step, set up in a window of its own; it edits the same step as the designer's panel -->
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{x:Static res:Strings.DatabaseStep_Refresh}" Command="{Binding RefreshCommand}" ToolTip.Tip="{x:Static res:Strings.DatabaseStep_RefreshTip}" />
                <Button Name="CloseButton" Classes="accent" Content="{x:Static res:Strings.Step_Done}" />
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="page-title" Text="{Binding Name}" />
                    <Border Classes="key-badge" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TypeText}" />
                    </Border>
                </StackPanel>
                <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.DatabaseStep_Subtitle}" />
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4">
            <SelectableTextBlock Name="ErrorText" Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
            <TextBlock Name="ProblemText" Classes="warning" TextWrapping="Wrap" Text="{Binding Problem}"
                       IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <Grid ColumnDefinitions="340,*" ColumnSpacing="16">
            <!-- Where, what, and the options of each -->
            <ScrollViewer>
                <StackPanel Spacing="16" Margin="0,0,8,0">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.DatabaseStep_Database}" />
                            <ComboBox Name="DatabaseBox" ItemsSource="{Binding DatabaseChoices}" SelectedItem="{Binding SelectedDatabase}" HorizontalAlignment="Stretch"
                                      PlaceholderText="{x:Static res:Strings.DatabaseStep_ChooseDatabase}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="engine:DatabaseChoice">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="info-label" FontFamily="{DynamicResource CodeFontFamily}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.DatabaseStep_NoDatabases}" IsVisible="{Binding HasNoDatabases}" />
                            <Button Name="AddConnectionButton" Classes="small" Content="{x:Static res:Strings.DatabaseStep_NewConnection}" Command="{Binding AddConnectionCommand}"
                                    IsVisible="{Binding CanAddConnection}" />
                            <Border Classes="table-row" IsVisible="{Binding IsAddingConnection}">
                                <ContentControl Content="{Binding NewConnection}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:ConnectionEditorViewModel">
                                            <views:ConnectionEditorView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>

                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.DatabaseStep_Schema}" />
                            <ComboBox Name="SchemaBox" ItemsSource="{Binding Schemas}" SelectedItem="{Binding Schema}" HorizontalAlignment="Stretch" />
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.DatabaseStep_Table}" />
                            <ComboBox Name="TableBox" ItemsSource="{Binding Tables}" SelectedItem="{Binding Table}" HorizontalAlignment="Stretch"
                                      PlaceholderText="{x:Static res:Strings.DatabaseStep_ChooseTable}" />
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding IsRead}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.DatabaseStep_OrderAndLimit}" />
                            <!-- A read's order and limit -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsRead}">
                                <TextBlock Classes="field-label" Text="{x:Static res:Strings.DatabaseStep_OrderBy}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding OrderChoices}" SelectedItem="{Binding OrderChoice}" HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Column="1" Classes="table-cell" VerticalAlignment="Center" Text="{x:Static res:Strings.DatabaseStep_Descending}" />
                                    <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding Descending}" />
                                </Grid>
                                <Border Classes="table-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{x:Static res:Strings.DatabaseStep_Limit}" />
                                            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.DatabaseStep_LimitTip}" />
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1" Value="{Binding Limit}" Minimum="0" Increment="100" FormatString="0" Width="130" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- An insert's or upsert's rows -->
                    <Border Classes="card" IsVisible="{Binding CanMakeManyRows}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.DatabaseStep_Rows}" />
                            <StackPanel Spacing="8">
                                <Border Classes="table-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{x:Static res:Strings.DatabaseStep_ManyRows}" />
                                            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.DatabaseStep_ManyRowsSwitchTip}" />
                                        </StackPanel>
                                        <ToggleSwitch Name="ManyRowsSwitch" Grid.Column="1" Classes="compact" IsChecked="{Binding ManyRows}" />
                                    </Grid>
                                </Border>
                                <StackPanel Spacing="8" IsVisible="{Binding ManyRows}">
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.DatabaseStep_RowsFrom}" />
                                    <TextBox Name="ItemsBox" Classes="code" Text="{Binding Items}" PlaceholderText="{x:Static res:Strings.DatabaseStep_RowsFromExample}" />
                                    <TextBlock Classes="field-label" Text="{x:Static res:Strings.DatabaseStep_EachRowIn}" />
                                    <TextBox Classes="code" Text="{Binding ItemVariable}" PlaceholderText="{x:Static res:Strings.DatabaseStep_ItemPlaceholder}" />
                                    <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding ManyRowsTip}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="card-title" Text="{x:Static res:Strings.Designer_Result}" />
                            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding ResultTip}" />
                            <Border Classes="table-row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{x:Static res:Strings.DatabaseStep_FirstRowOnly}" />
                                    <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding FirstRowOnly}" />
                                </Grid>
                            </Border>
                            <TextBlock Classes="field-label" Text="{x:Static res:Strings.Designer_KeepTheResultIn}" />
                            <ComboBox Name="ResultVariableBox" IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding VariableChoices}" Text="{Binding ResultVariable}"
                                      PlaceholderText="{x:Static res:Strings.Designer_OnlyInLast}" ToolTip.Tip="{x:Static res:Strings.Designer_ResultVariableTip}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- The columns, then the filters -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="16">
                <Border Name="ColumnsCard" Classes="card" IsVisible="{Binding UsesColumns}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="small" Content="{x:Static res:Strings.DatabaseStep_UseAll}" Command="{Binding UseAllCommand}" />
                                    <Button Classes="small" Content="{x:Static res:Strings.DatabaseStep_UseNone}" Command="{Binding UseNoneCommand}" />
                                </StackPanel>
                                <TextBlock Classes="card-title" Text="{x:Static res:Strings.DatabaseStep_Columns}" />
                            </DockPanel>
                            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding ColumnsTip}" />
                            <Grid ColumnDefinitions="32,1*,1.4*,Auto,1.3*,Auto" ColumnSpacing="10" Margin="0,4,0,0" IsVisible="{Binding HasColumns}">
                                <TextBlock Grid.Column="1" Classes="table-header" Text="{x:Static res:Strings.DatabaseStep_Column}" />
                                <TextBlock Grid.Column="2" Classes="table-header" Text="{x:Static res:Strings.DatabaseStep_Value}" IsVisible="{Binding GivesValues}" />
                                <TextBlock Grid.Column="3" Classes="table-header" Text="{x:Static res:Strings.DatabaseStep_KeyHeading}" IsVisible="{Binding IsUpsert}"
                                           ToolTip.Tip="{x:Static res:Strings.DatabaseStep_MatchTip}" />
                                <TextBlock Grid.Column="4" Classes="table-header" Text="{Binding VariableHeading}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="info-label" TextWrapping="Wrap" Text="{x:Static res:Strings.DatabaseStep_NoColumnsYet}"
                                   IsVisible="{Binding !HasColumns}" />
                        <ScrollViewer>
                            <ItemsControl Name="ColumnsList" ItemsSource="{Binding Columns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatabaseColumnViewModel">
                                        <Border Classes="table-row">
                                            <Grid ColumnDefinitions="32,1*,1.4*,Auto,1.3*,Auto" ColumnSpacing="10">
                                                <CheckBox IsChecked="{Binding IsUsed}" VerticalAlignment="Center" ToolTip.Tip="{x:Static res:Strings.DatabaseStep_UseTip}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                                        <Border Classes="key-badge" VerticalAlignment="Center" IsVisible="{Binding IsKey}">
                                                            <TextBlock Text="{x:Static res:Strings.DatabaseStep_Key}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="info-label" FontFamily="{DynamicResource CodeFontFamily}" Text="{Binding TypeText}" />
                                                    <TextBlock Classes="warning" Text="{x:Static res:Strings.DatabaseStep_NotInTable}" IsVisible="{Binding IsMissing}" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="2" IsEditable="True" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                          ItemsSource="{Binding $parent[ItemsControl].((vm:DatabaseStepViewModel)DataContext).ValueChoices}"
                                                          Text="{Binding Value}" PlaceholderText="{Binding ValueHint}" IsVisible="{Binding ShowsValue}" />
                                                <ToggleSwitch Grid.Column="3" Classes="compact" VerticalAlignment="Center" IsChecked="{Binding Match}" IsVisible="{Binding ShowsMatch}"
                                                              ToolTip.Tip="{x:Static res:Strings.DatabaseStep_MatchTip}" />
                                                <Grid Grid.Column="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                                    <ComboBox IsEditable="True" HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding $parent[ItemsControl].((vm:DatabaseStepViewModel)DataContext).VariableChoices}"
                                                              Text="{Binding Variable}" PlaceholderText="{x:Static res:Strings.DatabaseStep_NoVariable}" />
                                                    <TextBlock Grid.Column="1" Classes="table-cell" VerticalAlignment="Center" Text="{x:Static res:Strings.DatabaseStep_AllRows}"
                                                               ToolTip.Tip="{x:Static res:Strings.DatabaseStep_AllRowsTip}" />
                                                    <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding AllRows}" ToolTip.Tip="{x:Static res:Strings.DatabaseStep_AllRowsTip}" />
                                                </Grid>
                                                <Button Grid.Column="5" Classes="small" Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding IsMissing}"
                                                        ToolTip.Tip="{x:Static res:Strings.Designer_Remove}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Name="FiltersCard" Grid.Row="1" Classes="card" IsVisible="{Binding HasFilters}" MaxHeight="300">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Name="AddFilterButton" Classes="small" Content="{x:Static res:Strings.DatabaseStep_AddFilter}" Command="{Binding AddFilterCommand}" />
                                <TextBlock Classes="card-title" Text="{x:Static res:Strings.DatabaseStep_Filters}" />
                            </DockPanel>
                            <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding FiltersTip}" />
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl Name="FiltersList" ItemsSource="{Binding Filters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatabaseFilterViewModel">
                                        <Grid ColumnDefinitions="*,170,1.4*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                            <ComboBox ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding Column}" HorizontalAlignment="Stretch" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Operators}" SelectedItem="{Binding Operator}" HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="model:CompareOperator">
                                                        <TextBlock Text="{Binding Converter={x:Static model:StepTypes.OperatorConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding ValueChoices}" Text="{Binding Value}"
                                                      PlaceholderText="{x:Static res:Strings.DatabaseStep_FilterValue}" IsVisible="{Binding TakesValue}" />
                                            <Button Grid.Column="3" Classes="small" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="{x:Static res:Strings.Designer_Remove}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
