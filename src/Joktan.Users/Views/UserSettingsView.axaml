<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Users.Resources"
             xmlns:vm="using:Joktan.Users.ViewModels"
             xmlns:views="using:Joktan.Users.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="600"
             x:Class="Joktan.Users.Views.UserSettingsView"
             x:DataType="vm:UserSettingsViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.UserSettingsView_DatabaseTitle}" />
                        <TextBlock Classes="card-subtitle" TextWrapping="Wrap" Text="{x:Static res:Strings.UserSettingsView_DatabaseSubtitle}" />
                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.UserSettingsView_Database}" />
                        <ComboBox Name="DatabaseBox" MinWidth="320" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" />
                        <TextBlock Classes="info-label" TextWrapping="Wrap" Text="{Binding DatabaseText}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !IsCreating}">
                            <TextBlock Classes="info-label" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Static res:Strings.UserSettingsView_OrCreate}" />
                            <Button Name="CreateButton" Grid.Column="1" Content="{x:Static res:Strings.UsersView_Create}" Command="{Binding CreateDatabaseCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.UsersView_CreateTip}" />
                        </Grid>
                        <ContentControl Name="CreateForm" Content="{Binding CreateForm}" IsVisible="{Binding IsCreating}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:CreateDatabaseViewModel">
                                        <views:CreateDatabaseView />
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                            <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                            <TextBlock Classes="info-label" VerticalAlignment="Center">
                                <Run Text="{Binding Activity}" />
                                <Run Text="…" />
                            </TextBlock>
                        </StackPanel>
                        <SelectableTextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                                             IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
