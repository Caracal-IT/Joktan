<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Joktan.Settings.Resources"
             xmlns:vm="using:Joktan.Settings.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="736"
             x:Class="Joktan.Settings.Views.LoggingSettingsView"
             x:DataType="vm:LoggingSettingsViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <Border Classes="card" Margin="24" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <StackPanel>
                        <TextBlock Classes="card-title" Text="{x:Static res:Strings.LoggingSettingsView_Logging}" />
                        <TextBlock Classes="card-subtitle" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.LoggingSettingsView_LogsAreSentOverOTLP}" />
                    </StackPanel>

                    <Border Classes="table-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="table-cell" Text="{x:Static res:Strings.LoggingSettingsView_SendLogs}" />
                            <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Enabled}"
                                          ToolTip.Tip="{x:Static res:Strings.LoggingSettingsView_SendLogsTip}" />
                        </Grid>
                    </Border>

                    <StackPanel>
                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.LoggingSettingsView_Level}" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                                  ToolTip.Tip="{x:Static res:Strings.LoggingSettingsView_LevelTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogLevelChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="field-label" Text="{x:Static res:Strings.LoggingSettingsView_Endpoint}" />
                        <TextBox Classes="code" Text="{Binding EndpointText}"
                                 PlaceholderText="{x:Static res:Strings.LoggingSettingsView_EndpointPlaceholder}" />
                        <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.LoggingSettingsView_EndpointHint}" />
                        <TextBlock Classes="error" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding EndpointError}"
                                   IsVisible="{Binding EndpointError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>

</UserControl>
