<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Joktan.Containers.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="Joktan.Containers.Views.ContainersView"
             x:DataType="vm:ContainersViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="page-header">
            <StackPanel>
                <TextBlock Classes="page-title" Text="{Binding Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
                <TextBlock Classes="info-label" VerticalAlignment="Center">
                    <Run Text="{Binding Activity}" />
                    <Run Text="…" />
                </TextBlock>
                <Button Classes="small" Content="Cancel" Command="{Binding CancelCommand}"
                        ToolTip.Tip="Stop the command. Containers it already changed stay as they are." />
            </StackPanel>
            <TextBlock Classes="error" TextWrapping="Wrap"
                       Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Grid Margin="24,16,24,24" RowDefinitions="Auto,16,*">

            <Grid ColumnDefinitions="3*,16,2*">
                <!-- Each file's services and their containers -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="Services" />
                                <TextBlock Classes="card-subtitle" Text="{Binding Summary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="small" Content="Refresh" VerticalAlignment="Top"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="Check the containers now, and look for Docker and Podman again. They are checked every 5 seconds while this page is shown." />
                        </Grid>

                        <TextBlock Classes="info-label" TextWrapping="Wrap" IsVisible="{Binding !HasProjects}"
                                   Text="No compose files yet. Add one under Compose files." />

                        <Grid ColumnDefinitions="150,1.1*,*,100,150" ColumnSpacing="12" Margin="0,0,0,2" IsVisible="{Binding HasProjects}">
                            <TextBlock Classes="table-header" Text="Service" />
                            <TextBlock Grid.Column="1" Classes="table-header" Text="Container" />
                            <TextBlock Grid.Column="2" Classes="table-header" Text="Status" />
                            <TextBlock Grid.Column="3" Classes="table-header" Text="Ports" />
                        </Grid>
                        <ScrollViewer MaxHeight="420">
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComposeProjectViewModel">
                                        <StackPanel Spacing="4" Margin="0,4,0,8">
                                            <!-- The file, and commands for all its services -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Button Classes="small" Content="{Binding ExpandText}" Command="{Binding ToggleExpandedCommand}"
                                                        VerticalAlignment="Center" ToolTip.Tip="Show or hide its services" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Classes="info-label" FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Details}" ToolTip.Tip="{Binding File}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Classes="small accent" Content="Start" Command="{Binding UpCommand}"
                                                            ToolTip.Tip="compose up -d: create the containers if needed, building images where the file says so, and start them" />
                                                    <Button Classes="small" Content="Stop" Command="{Binding StopCommand}"
                                                            ToolTip.Tip="compose stop: stop the containers and keep them, to start again later" />
                                                    <Button Classes="small" Content="Restart" Command="{Binding RestartCommand}"
                                                            ToolTip.Tip="compose restart: stop and start the containers without recreating them" />
                                                    <Button Classes="small" Content="Down" Command="{Binding DownCommand}"
                                                            ToolTip.Tip="compose down: stop and remove the containers and their network. Volumes are kept." />
                                                    <Button Classes="small" Content="More" ToolTip.Tip="More commands for every service in this file">
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuItem Header="Recreate" Command="{Binding RecreateCommand}"
                                                                          ToolTip.Tip="compose up -d --force-recreate: make new containers even when nothing changed, and start them" />
                                                                <MenuItem Header="Rebuild and start" Command="{Binding RebuildCommand}"
                                                                          ToolTip.Tip="compose up -d --build: build the images again, then recreate and start the containers" />
                                                                <Separator />
                                                                <MenuItem Header="Pull images" Command="{Binding PullCommand}"
                                                                          ToolTip.Tip="compose pull --ignore-buildable: fetch the latest images; images built from the file are left out" />
                                                                <MenuItem Header="Build images" Command="{Binding BuildCommand}"
                                                                          ToolTip.Tip="compose build: build the images without starting anything" />
                                                                <Separator />
                                                                <MenuItem Header="Pause" Command="{Binding PauseCommand}" ToolTip.Tip="compose pause: freeze the running containers" />
                                                                <MenuItem Header="Resume" Command="{Binding UnpauseCommand}" ToolTip.Tip="unpause: let the paused containers run again" />
                                                                <MenuItem Header="Kill" Command="{Binding KillCommand}" ToolTip.Tip="compose kill: stop the containers at once, without letting them shut down" />
                                                                <Separator />
                                                                <MenuItem Header="Down and remove volumes…" Command="{Binding DownWithVolumesCommand}"
                                                                          ToolTip.Tip="compose down --volumes: as Down, and delete the volumes and what is in them" />
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding NameWarning}"
                                                       IsVisible="{Binding NameWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                                                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                            <!-- Down with volumes, once confirmed -->
                                            <Border Classes="group-row" Padding="12" IsVisible="{Binding IsConfirmingDownWithVolumes}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock Classes="table-cell" TextWrapping="Wrap" Text="{Binding DownWithVolumesText}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Content="Cancel" Command="{Binding CancelDownWithVolumesCommand}" />
                                                        <Button Classes="accent" Content="Delete volumes" Command="{Binding ConfirmDownWithVolumesCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Services}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ComposeServiceRow">
                                                        <Border Classes="table-row">
                                                            <Grid ColumnDefinitions="150,1.1*,*,100,150" ColumnSpacing="12">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Ellipse Classes="state-dot"
                                                                             Classes.ok="{Binding IsRunning}"
                                                                             Classes.pending="{Binding IsPaused}"
                                                                             Classes.failed="{Binding IsStopped}" />
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Classes="table-cell" FontWeight="SemiBold" Text="{Binding Service}" />
                                                                        <TextBlock Classes="info-label" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="130"
                                                                                   Text="{Binding Image}" ToolTip.Tip="{Binding Image}"
                                                                                   IsVisible="{Binding Image, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Classes="table-cell" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                                                <TextBlock Grid.Column="2" Classes="table-cell" Text="{Binding Status}" ToolTip.Tip="{Binding Status}" />
                                                                <TextBlock Grid.Column="3" Classes="table-cell" Text="{Binding Ports}" ToolTip.Tip="{Binding Ports}" />
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                                    <Button Classes="small" Content="Start"
                                                                            IsVisible="{Binding CanStart}"
                                                                            Command="{Binding Project.UpCommand}"
                                                                            CommandParameter="{Binding Service}"
                                                                            ToolTip.Tip="compose up -d for this service" />
                                                                    <Button Classes="small" Content="Resume"
                                                                            IsVisible="{Binding IsPaused}"
                                                                            Command="{Binding Project.UnpauseCommand}"
                                                                            CommandParameter="{Binding Service}"
                                                                            ToolTip.Tip="unpause: let it run again" />
                                                                    <Button Classes="small" Content="Stop"
                                                                            IsVisible="{Binding IsRunning}"
                                                                            Command="{Binding Project.StopCommand}"
                                                                            CommandParameter="{Binding Service}"
                                                                            ToolTip.Tip="compose stop for this service" />
                                                                    <Button Classes="small" Content="Restart"
                                                                            IsVisible="{Binding IsRunning}"
                                                                            Command="{Binding Project.RestartCommand}"
                                                                            CommandParameter="{Binding Service}"
                                                                            ToolTip.Tip="compose restart for this service" />
                                                                    <Button Classes="small" Content="⋯" ToolTip.Tip="More for this service">
                                                                        <Button.Flyout>
                                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                <MenuItem Header="Show its logs" Command="{Binding Project.ShowServiceLogsCommand}" CommandParameter="{Binding Service}" />
                                                                                <MenuItem Header="Open a shell in a terminal" Command="{Binding Project.OpenShellCommand}" CommandParameter="{Binding Service}"
                                                                                          IsEnabled="{Binding IsRunning}"
                                                                                          ToolTip.Tip="exec -it with sh inside the running container" />
                                                                                <MenuItem Header="Copy the container name" Click="OnCopyContainerNameClick" IsEnabled="{Binding HasContainer}" />
                                                                                <Separator />
                                                                                <MenuItem Header="Recreate" Command="{Binding Project.RecreateCommand}" CommandParameter="{Binding Service}"
                                                                                          ToolTip.Tip="compose up -d --force-recreate: a new container even when nothing changed" />
                                                                                <MenuItem Header="Rebuild and start" Command="{Binding Project.RebuildCommand}" CommandParameter="{Binding Service}"
                                                                                          ToolTip.Tip="compose up -d --build: build its image again, then recreate and start it" />
                                                                                <MenuItem Header="Pull image" Command="{Binding Project.PullCommand}" CommandParameter="{Binding Service}"
                                                                                          ToolTip.Tip="compose pull --ignore-buildable: fetch the latest image, unless it is built from the file" />
                                                                                <Separator />
                                                                                <MenuItem Header="Pause" Command="{Binding Project.PauseCommand}" CommandParameter="{Binding Service}"
                                                                                          IsVisible="{Binding IsRunning}" ToolTip.Tip="compose pause: freeze it" />
                                                                                <MenuItem Header="Resume" Command="{Binding Project.UnpauseCommand}" CommandParameter="{Binding Service}"
                                                                                          IsVisible="{Binding IsPaused}" ToolTip.Tip="unpause: let it run again" />
                                                                                <MenuItem Header="Kill" Command="{Binding Project.KillCommand}" CommandParameter="{Binding Service}"
                                                                                          IsVisible="{Binding IsRunning}" ToolTip.Tip="compose kill: stop it at once, without letting it shut down" />
                                                                                <MenuItem Header="Remove container" Command="{Binding Project.RemoveContainerCommand}" CommandParameter="{Binding Service}"
                                                                                          IsVisible="{Binding HasContainer}" ToolTip.Tip="compose rm --stop --force: stop and remove it; Start makes it again" />
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Compose files and engine -->
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="Compose files" />
                            <TextBlock Classes="card-subtitle"
                                       Text="Each file is its own project. Commands run from the file's folder, so its .env is read. Saved as you change them." />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComposeProjectViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                            <TextBlock Classes="code" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding File}" ToolTip.Tip="{Binding File}" />
                                            <Button Grid.Column="1" Classes="small" Content="Remove" Command="{Binding RemoveCommand}"
                                                    ToolTip.Tip="Stop showing this file. Its containers are left as they are." />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Classes="code" Text="{Binding NewComposeFile}" PlaceholderText="Path of a compose file" />
                                <Button Grid.Column="1" Content="Add" Command="{Binding AddTypedCommand}" />
                                <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseCommand}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="Engine" />
                            <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Auto uses Docker when its engine is running and Podman otherwise" />
                            <TextBlock Classes="info-label" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{Binding EngineText}"
                                       IsVisible="{Binding EngineText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Logs and command output -->
            <Border Grid.Row="2" Classes="card" Padding="0">
                <TabControl Name="BottomTabs" Padding="16,8,16,16">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="16,0" />
                        </Style>
                    </TabControl.Styles>
                    <TabItem Header="Logs">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,8,0,8">
                                <Button Classes="accent" Content="{Binding LogsButtonText}" Command="{Binding ToggleLogsCommand}" MinWidth="96"
                                        ToolTip.Tip="compose logs --follow: show what the containers write, as they write it" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LogChoices}" SelectedItem="{Binding SelectedLog}" MinWidth="220"
                                          ToolTip.Tip="Whose logs to show: one file's services, or one of them">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComposeLogChoice">
                                            <TextBlock>
                                                <Run Text="{Binding Project.Name}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding ServiceText}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="Last" />
                                    <NumericUpDown Value="{Binding TailLines}" Minimum="0" Maximum="5000" Increment="100" FormatString="0" Width="120"
                                                   ToolTip.Tip="How many earlier lines of each container's log to show when the logs start" />
                                    <TextBlock Classes="info-label" VerticalAlignment="Center" Text="lines" />
                                </StackPanel>
                                <CheckBox Grid.Column="3" Content="Timestamps" IsChecked="{Binding ShowTimestamps}" />
                                <CheckBox Grid.Column="5" Content="Keep newest in view" IsChecked="{Binding AutoScroll}" />
                                <Button Grid.Column="6" Classes="small" Content="Copy" Click="OnCopyLogsClick" VerticalAlignment="Center"
                                        ToolTip.Tip="Copy the lines shown" />
                                <Button Grid.Column="7" Classes="small" Content="Clear" Command="{Binding ClearLogsCommand}" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="LogList" Classes="log console" ItemsSource="{Binding LogLines}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="code" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Command output">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,8,0,8">
                                <TextBlock Classes="info-label" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="What Start, Stop, Restart and Down wrote, after each file's name and command line." />
                                <Button Grid.Column="1" Classes="small" Content="Copy" Click="OnCopyOutputClick" />
                                <Button Grid.Column="2" Classes="small" Content="Clear" Command="{Binding ClearOutputCommand}" />
                            </Grid>
                            <ListBox x:Name="OutputList" Classes="log console" ItemsSource="{Binding Output}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="code" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
